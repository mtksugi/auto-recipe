{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "auto-recipe",
  "main": "worker/index.ts",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/data/recipes.json"]
  },
  "r2_buckets": [
    {
      "binding": "RECIPES",
      "bucket_name": "auto-recipe"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RECIPE_COORDINATOR",
        "class_name": "UserRecipeCoordinator"
      }
    ]
  },
  "exports": {
    "UserRecipeCoordinator": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.md"],
      "fallthrough": true
    }
  ],
  "vars": {
    "OPENAI_MODEL": "gpt-5.6-terra",
    "TEAM_DOMAIN": "https://mtk11.cloudflareaccess.com",
    "POLICY_AUD": "a8ce8d4f623b9a5ba68b589137cff9e0b58085d1a675ad3711ba5d8a15c6cc19"
  },
  "observability": {
    "enabled": true
  }
}
